<CALL:5>JA1XX<QSO_DATE:8>20240116<TIME_ON:4>2330<BAND:3>40M<MODE:2>CW<RST_SENT:3>599<RST_RCVD:3>579<STATION_CALLSIGN:6>N0CALL<APP_LOTW_RP:1>N<EOR>
